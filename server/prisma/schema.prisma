// VideoText production user store. Run: npx prisma generate, npx prisma migrate deploy
generator client {
  provider = "prisma-client-js"
}

// Connection URL is set in prisma.config.ts (Prisma 7+)
datasource db {
  provider = "postgresql"
}

model User {
  id                       String   @id
  email                    String
  name                     String?
  passwordHash             String   @default("")
  plan                     String   // free | basic | pro | agency
  stripeCustomerId         String?  @unique
  subscriptionId           String?
  paymentMethodId          String?
  billingPeriodStart       DateTime?
  billingPeriodEnd         DateTime?
  passwordSetupToken       String?
  passwordSetupExpiresAt   DateTime?
  passwordSetupUsed        Boolean  @default(false)
  passwordResetToken       String?
  passwordResetExpiresAt   DateTime?
  usageThisMonth           Json     // { totalMinutes, videoCount, ... resetDate (ISO string) }
  limits                   Json     // PlanLimits
  overagesThisMonth        Json     // { minutes, languages, batches, totalCharge }
  role                     String   @default("user")  // founder | admin | user
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  firstReferrer            String?
  firstSeenAt              DateTime?
  lastActiveAt             DateTime?
  createdAt                DateTime
  updatedAt                DateTime

  @@index([createdAt])
}

model Job {
  id               String   @id
  userId           String
  toolType         String   // transcript, subtitles, translation, etc.
  status           String   // queued | processing | completed | failed

  fileSizeBytes    BigInt?
  videoDurationSec Int?

  startedAt        DateTime?
  completedAt      DateTime?
  processingMs     Int?

  failureReason    String?
  planAtRun        String?

  // AI cost tracking (stored in micro-dollars, i.e. 1 = $0.000001, so $0.006/min = 6000 per minute)
  // Using cents (1 = $0.01) for simplicity: whisper $0.006/min → 1 cent per ~1.67 min
  whisperCostMicros   Int?  // cost in micro-dollars ($1 = 1,000,000)
  totalAiCostMicros   Int?  // total AI cost (whisper + any LLM) in micro-dollars

  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([toolType, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
}

// Pro (and team) — read-only public snapshot for sharing transcripts
model TranscriptShare {
  id             String    @id @default(cuid())
  slug           String    @unique
  userId         String
  jobId          String
  variant        String    // original | translated
  sourceTool     String    // video-to-transcript | voice-to-text
  title          String    @default("")
  targetLanguage String?
  payload        Json
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  @@index([userId])
  @@index([jobId])
}

model SubscriptionSnapshot {
  id                    String   @id @default(cuid())
  userId                String

  plan                  String
  priceMonthly          Int      // stored in cents (MRR-normalized); sum only within same currency
  currency              String   // from invoice; MRR queries assume single currency (e.g. USD) or convert

  periodStart           DateTime
  periodEnd             DateTime

  status                String   // active | canceled | past_due | historical

  stripeSubscriptionId  String?
  stripePriceId         String?
  billingInterval       String?  // month | year
  intervalCount         Int?

  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([periodStart])
  @@index([periodStart, periodEnd])
  @@index([stripeSubscriptionId, periodStart])
}

model DailyMetrics {
  date                DateTime @id // truncated to midnight UTC

  totalUsers          Int
  newUsers            Int
  activeUsers         Int

  jobsCreated         Int
  jobsCompleted       Int
  jobsFailed          Int

  avgProcessingMs     Int?
  p95ProcessingMs     Int?

  mrrCents            Int
  churnedUsers        Int
  newPaidUsers        Int

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MonthlyMetrics {
  monthStart          DateTime @id // first day of month UTC

  totalUsers          Int
  newUsers            Int
  activeUsers         Int

  mrrCents            Int
  newMrrCents         Int
  churnedMrrCents     Int

  churnRatePercent    Float?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Batch job state shared by API and worker (persisted so separate containers see same state).
model BatchJobRecord {
  id               String    @id
  userId           String
  totalVideos      Int
  totalDuration    Int       // seconds
  processedVideos  Int       @default(0)
  failedVideos     Int       @default(0)
  status           String    // queued | processing | completed | failed | partial
  zipPath          String?
  zipSize          Int?
  errors           Json      @default("[]") // [{ videoName, reason }]
  createdAt        DateTime
  completedAt      DateTime?
  expiresAt        DateTime
}

// Processed Stripe webhook event IDs — prevents double-processing on server restarts or retries.
model StripeEventLog {
  eventId     String   @id          // Stripe event ID (evt_xxx)
  eventType   String                // e.g. invoice.payment_succeeded
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ─── Behavioral event tracking for funnel analytics and feedback triggers ────
model EventLog {
  id          String   @id @default(cuid())
  eventName   String   // upload_started | transcription_completed | result_viewed | export_clicked | session_returned
  userId      String?
  sessionId   String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
}

// ─── Structured feedback from contextual triggers (A–E) ──────────────────────
model FeedbackEvent {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String
  triggerType String   // result | export | dropoff | pmf | competitor
  rating      String?  // e.g. "Perfect", "Good but needs tweaks", "Very disappointed"
  category    String?  // e.g. "Accuracy", "Speed", "Speaker labels"
  freeText    String   @default("")
  userScore   Int?     // denormalized user engagement score at submission time
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([triggerType, createdAt])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

// ─── Computed user engagement metrics for scoring and segmentation ────────────
model UserMetrics {
  userId          String   @id
  totalSessions   Int      @default(0)
  totalExports    Int      @default(0)
  hasReturned     Boolean  @default(false)
  isPaying        Boolean  @default(false)
  userScore       Int      @default(0)
  segment         String   @default("explorer") // explorer | activated | power_user | paying
  pmfShown        Boolean  @default(false)
  competitorShown Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@index([segment])
  @@index([userScore])
}

// User feedback from Tex panel (post-job completion) or public survey link. No auth required to submit.
model Feedback {
  id              String   @id @default(cuid())
  toolId          String?  // e.g. video-to-transcript, video-to-subtitles (where stars were collected)
  stars           Int?     // 1-5
  comment         String   @default("")  // "How can we improve?"
  userId          String?  // if logged in
  userNameOrEmail String?  // for free users: name or email when they share it
  planAtSubmit    String?  // free | basic | pro | agency at time of feedback
  // Survey-specific fields (from shareable /survey page)
  email           String?  // explicit email collected from survey form
  topTool         String?  // "What tool impressed you the most?"
  topToolReason   String?  // "Why?"
  featureRequest  String?  // "Any feature in your mind that would ease your workflow?"
  otherFeedback   String?  // "Anything else in your mind?"
  source          String?  // 'in-app' | 'survey'
  createdAt       DateTime @default(now())
}
