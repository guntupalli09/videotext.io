// VideoText production user store. Run: npx prisma generate, npx prisma migrate deploy
generator client {
  provider = "prisma-client-js"
}

// Connection URL is set in prisma.config.ts (Prisma 7+)
datasource db {
  provider = "postgresql"
}

model User {
  id                       String   @id
  email                    String
  name                     String?
  passwordHash             String   @default("")
  plan                     String   // free | basic | pro | agency
  stripeCustomerId         String?  @unique
  subscriptionId           String?
  paymentMethodId          String?
  billingPeriodStart       DateTime?
  billingPeriodEnd         DateTime?
  subscriptionStatus       String?   // active | past_due | canceled | trialing | incomplete
  cancelAtPeriodEnd        Boolean   @default(false)
  passwordSetupToken       String?
  passwordSetupExpiresAt   DateTime?
  passwordSetupUsed        Boolean  @default(false)
  passwordResetToken       String?
  passwordResetExpiresAt   DateTime?
  usageThisMonth           Json     // { totalMinutes, videoCount, ... resetDate (ISO string) }
  limits                   Json     // PlanLimits
  overagesThisMonth        Json     // { minutes, languages, batches, totalCharge }
  role                     String   @default("user")  // founder | admin | user
  newsletterSubscribed     Boolean  @default(true)
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  firstReferrer            String?
  firstSeenAt              DateTime?
  lastActiveAt             DateTime?
  createdAt                DateTime
  updatedAt                DateTime

  // Analytics Sprint 2: canonical user taxonomy (docs/analytics/USER_TAXONOMY.md).
  // Additive only. Existing rows are backfilled to these defaults by the
  // migration itself (Postgres ADD COLUMN ... DEFAULT is metadata-only and
  // applies the default to every existing row); only rows that deviate from
  // "a normal registered user" (demo/founder/internal/etc.) are explicitly
  // updated by server/src/scripts/backfill-user-taxonomy.ts. Nothing reads
  // these columns yet — application code changes are a later, separate sprint.
  userClass                String   @default("registered") // registered | demo | founder | internal | developer | qa | bot
  isFounder                Boolean  @default(false)
  isInternal               Boolean  @default(false)
  isDeveloper              Boolean  @default(false)
  isQa                     Boolean  @default(false)
  isDemo                   Boolean  @default(false)
  isBot                    Boolean  @default(false)
  isDeleted                Boolean  @default(false) // reserved for a future soft-delete path; current deletion is hard-delete (see delete-test-users.ts / adminSupport.ts) and does not set this yet
  includeInBusinessMetrics Boolean  @default(true)  // NOT (isFounder OR isInternal OR isDeveloper OR isQa OR isDemo OR isBot OR isDeleted); computed by the backfill script for existing rows, not a DB-generated column

  upgradeIntents           UpgradeIntent[]

  @@index([createdAt])
  @@index([userClass])
  @@index([includeInBusinessMetrics])
}


model UpgradeIntent {
  id        String   @id @default(cuid())
  userId    String
  source    String   // upgrade_clicked | checkout_session_started
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Job {
  id               String   @id
  userId           String
  toolType         String   // transcript, subtitles, translation, etc.
  status           String   // queued | processing | completed | failed

  fileSizeBytes    BigInt?
  videoDurationSec Int?

  startedAt        DateTime?
  completedAt      DateTime?
  processingMs     Int?

  failureReason    String?
  planAtRun        String?

  // AI cost tracking (stored in micro-dollars, i.e. 1 = $0.000001, so $0.006/min = 6000 per minute)
  // Using cents (1 = $0.01) for simplicity: whisper $0.006/min → 1 cent per ~1.67 min
  whisperCostMicros   Int?  // cost in micro-dollars ($1 = 1,000,000)
  totalAiCostMicros   Int?  // total AI cost (whisper + any LLM) in micro-dollars

  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([toolType, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
}

// Pro (and team) — read-only public snapshot for sharing transcripts
model TranscriptShare {
  id             String    @id @default(cuid())
  slug           String    @unique
  userId         String
  jobId          String
  variant        String    // original | translated
  sourceTool     String    // video-to-transcript | voice-to-text
  title          String    @default("")
  targetLanguage String?
  payload        Json
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  @@index([userId])
  @@index([jobId])
}

model SubscriptionSnapshot {
  id                    String   @id @default(cuid())
  userId                String

  plan                  String
  priceMonthly          Int      // stored in cents (MRR-normalized); sum only within same currency
  currency              String   // from invoice; MRR queries assume single currency (e.g. USD) or convert

  periodStart           DateTime
  periodEnd             DateTime

  status                String   // active | canceled | past_due | historical

  stripeSubscriptionId  String?
  stripePriceId         String?
  billingInterval       String?  // month | year
  intervalCount         Int?

  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([periodStart])
  @@index([periodStart, periodEnd])
  @@index([stripeSubscriptionId, periodStart])
}

// Analytics Sprint 1 (revised): current-state summary derived from
// SubscriptionSnapshot (which remains, unchanged, the append-only history
// ledger — every invoice/cancellation event still writes a new row there).
// This table holds exactly one row per real Stripe subscription, upserted on
// every relevant webhook, so MRR can be read as a plain SUM with no
// deduplication logic needed at query time. Additive only — nothing reads
// this table until it is explicitly wired in behind a feature flag; no
// existing table, column, or write path is affected by its existence.
// See docs/analytics/DATABASE_MIGRATION_PLAN.md (M4) and
// docs/analytics/METRICS.md (business_subscriptions) for the design this
// implements.
model SubscriptionCurrentState {
  stripeSubscriptionId  String   @id
  userId                String

  status                String   // active | canceled | past_due | trialing | incomplete
  plan                  String

  // Canonical MRR (operator decision 2026-07-27, Sprint 1): the subscription's
  // CONTRACTUAL recurring value, independent of any temporary invoice-level
  // discount/promo code. This is the number "MRR" means everywhere in this
  // codebase and in docs/analytics/METRICS.md.
  normalizedMonthlyCents Int     // MRR-normalized cents (annual / 12); single-currency assumption, same as SubscriptionSnapshot
  currency              String
  stripePriceId         String?
  billingInterval       String?  // month | year
  intervalCount         Int?

  // Collected cash is intentionally a SEPARATE metric from MRR above, not a
  // substitute for it — this is the actual amount_paid on the most recent
  // invoice for this subscription (can be less than normalizedMonthlyCents
  // during an active 100%-off/partial promo period; equal to it once the
  // promo lapses). Never summed into or confused with MRR in reporting.
  lastInvoiceId              String?
  lastInvoiceAmountPaidCents Int?

  periodStart           DateTime?
  periodEnd             DateTime?

  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model DailyMetrics {
  date                DateTime @id // truncated to midnight UTC

  totalUsers          Int
  newUsers            Int
  activeUsers         Int

  jobsCreated         Int
  jobsCompleted       Int
  jobsFailed          Int

  avgProcessingMs     Int?
  p95ProcessingMs     Int?

  mrrCents            Int
  churnedUsers        Int
  newPaidUsers        Int

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MonthlyMetrics {
  monthStart          DateTime @id // first day of month UTC

  totalUsers          Int
  newUsers            Int
  activeUsers         Int

  mrrCents            Int
  newMrrCents         Int
  churnedMrrCents     Int

  churnRatePercent    Float?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Batch job state shared by API and worker (persisted so separate containers see same state).
model BatchJobRecord {
  id               String    @id
  userId           String
  totalVideos      Int
  totalDuration    Int       // seconds
  processedVideos  Int       @default(0)
  failedVideos     Int       @default(0)
  status           String    // queued | processing | completed | failed | partial
  zipPath          String?
  zipSize          Int?
  errors           Json      @default("[]") // [{ videoName, reason }]
  createdAt        DateTime
  completedAt      DateTime?
  expiresAt        DateTime
}

// Processed Stripe webhook event IDs — prevents double-processing on server restarts or retries.
model StripeEventLog {
  eventId     String   @id          // Stripe event ID (evt_xxx)
  eventType   String                // e.g. invoice.payment_succeeded
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ─── Behavioral event tracking for funnel analytics and feedback triggers ────
model EventLog {
  id          String   @id @default(cuid())
  eventName   String   // upload_started | transcription_completed | result_viewed | export_clicked | session_returned
  userId      String?
  sessionId   String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
}

// ─── Structured feedback from contextual triggers (A–E) ──────────────────────
model FeedbackEvent {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String
  triggerType String   // result | export | dropoff | pmf | competitor
  rating      String?  // e.g. "Perfect", "Good but needs tweaks", "Very disappointed"
  category    String?  // e.g. "Accuracy", "Speed", "Speaker labels"
  freeText    String   @default("")
  userScore   Int?     // denormalized user engagement score at submission time
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([triggerType, createdAt])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

// ─── Computed user engagement metrics for scoring and segmentation ────────────
model UserMetrics {
  userId          String   @id
  totalSessions   Int      @default(0)
  totalExports    Int      @default(0)
  hasReturned     Boolean  @default(false)
  isPaying        Boolean  @default(false)
  userScore       Int      @default(0)
  segment         String   @default("explorer") // explorer | activated | power_user | paying
  pmfShown        Boolean  @default(false)
  competitorShown Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@index([segment])
  @@index([userScore])
}

// User feedback from Tex panel (post-job completion) or public survey link. No auth required to submit.
// Async guideline formatting job (OpenAI + diff); polled from /api/guidelines/jobs/:id
model FormattingJob {
  id               String   @id @default(cuid())
  userId           String
  jobToken         String?  @unique
  inputText        String   @db.Text
  status           String   // queued | processing | completed | failed
  stage            String?  // queued | formatting | validating | completed | failed
  outputText       String?  @db.Text
  diffData         Json?
  flaggedSegments  Json?
  appliedRules     Json
  validationReport Json?
  presetId         String?
  failureReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model Feedback {
  id              String   @id @default(cuid())
  toolId          String?  // e.g. video-to-transcript, video-to-subtitles (where stars were collected)
  stars           Int?     // 1-5
  comment         String   @default("")  // "How can we improve?"
  userId          String?  // if logged in
  userNameOrEmail String?  // for free users: name or email when they share it
  planAtSubmit    String?  // free | basic | pro | agency at time of feedback
  // Survey-specific fields (from shareable /survey page)
  email           String?  // explicit email collected from survey form
  topTool         String?  // "What tool impressed you the most?"
  topToolReason   String?  // "Why?"
  featureRequest  String?  // "Any feature in your mind that would ease your workflow?"
  otherFeedback   String?  // "Anything else in your mind?"
  source          String?  // 'in-app' | 'survey'
  createdAt       DateTime @default(now())
}
