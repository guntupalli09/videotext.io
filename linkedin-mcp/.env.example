# LinkedIn OAuth 2.0 (3-legged)
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_ACCESS_TOKEN=your_access_token
LINKEDIN_REFRESH_TOKEN=your_refresh_token

# VideoText.io Company Page
LINKEDIN_ORGANIZATION_ID=your_org_id

# OpenAI (for content + image generation)
OPENAI_API_KEY=your_openai_key

# Optional: Posting schedule (cron expression, default 9am UTC weekdays)
POST_SCHEDULE="0 9 * * 1-5"
