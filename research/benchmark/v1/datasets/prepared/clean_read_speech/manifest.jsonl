{"id": "8230-279154-0000", "condition": "clean_read_speech", "speaker_id": "8230", "reference_text": "THE ANALYSIS OF KNOWLEDGE WILL OCCUPY US UNTIL THE END OF THE THIRTEENTH LECTURE AND IS THE MOST DIFFICULT PART OF OUR WHOLE ENTERPRISE", "audio_path": "v1/datasets/prepared/clean_read_speech/8230-279154-0000.wav", "duration_sec": 8.805, "source_dataset": "LibriSpeech test-clean", "source_license": "CC BY 4.0 (Vassil Panayotov, 2014)", "source_url": "https://www.openslr.org/12/", "ground_truth_provenance": "verbatim from corpus .trans.txt"}
{"id": "8230-279154-0001", "condition": "clean_read_speech", "speaker_id": "8230", "reference_text": "WHAT IS CALLED PERCEPTION DIFFERS FROM SENSATION BY THE FACT THAT THE SENSATIONAL INGREDIENTS BRING UP HABITUAL ASSOCIATES IMAGES AND EXPECTATIONS OF THEIR USUAL CORRELATES ALL OF WHICH ARE SUBJECTIVELY INDISTINGUISHABLE FROM THE SENSATION", "audio_path": "v1/datasets/prepared/clean_read_speech/8230-279154-0001.wav", "duration_sec": 17.38, "source_dataset": "LibriSpeech test-clean", "source_license": "CC BY 4.0 (Vassil Panayotov, 2014)", "source_url": "https://www.openslr.org/12/", "ground_truth_provenance": "verbatim from corpus .trans.txt"}
