# Google Search Console API (service account)
GSC_CLIENT_EMAIL=videotext-gsc@your-project-id.iam.gserviceaccount.com
# Keep the key as one line with literal \n characters; fetch script converts \n -> actual newlines.
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
# Must match Search Console property URL exactly (e.g. https://www.videotext.io/)
GSC_SITE_URL=https://www.videotext.io/

# Optional override for KPI monitor input
# GSC_INPUT_JSON=scripts/seo/data/gsc-latest.json

# Production Redis security
# Required by docker-compose.yml. Generate with: openssl rand -hex 32
# If you override REDIS_URL outside Docker Compose, URL-encode special characters in the password.
REDIS_PASSWORD=replace-with-a-long-random-password
# Docker Compose sets REDIS_URL for api/worker automatically from REDIS_PASSWORD.
# REDIS_URL=redis://:replace-with-a-url-encoded-password@redis:6379
