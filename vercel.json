{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/:path*/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/otter-alternative", "dest": "/otter-ai-alternative", "status": 301 },
    { "handle": "filesystem" },
    { "src": "/((?!.*\\.).*)", "dest": "/index.html" }
  ]
}
