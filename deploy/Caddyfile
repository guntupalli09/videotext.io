# TLS termination + reverse proxy only.
# Do not intercept OPTIONS or set Access-Control-* here. Express owns CORS
# (trusted origins + reflected Allow-Headers). A closed header list in Caddy
# caused production "Failed to fetch" when the Vercel client added
# x-ph-distinct-id (2026-09-14).
api.videotext.io {
	reverse_proxy localhost:3001
}
